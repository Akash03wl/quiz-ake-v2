{
  "name": "quiz-ake",
  "version": "1.0.0",
  "description": "Quiz AKE - plataforma de quizzes (Cloudflare Pages + Functions + D1 + Workers AI)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev . --d1 DB",
    "deploy": "wrangler pages deploy . --d1 DB",
    "db:migrate:local": "wrangler d1 migrations apply quiz-ake-db --local",
    "db:migrate": "wrangler d1 migrations apply quiz-ake-db --remote",
    "test": "node test/backend.test.js && node test/smoke.js",
    "test:check": "node test/backend.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}