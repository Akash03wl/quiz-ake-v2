# ============================================================
# NIVORA - Simulados com IA — variáveis de ambiente
# Aprenda. Supere. Evolua.
# NUNCA commite secrets reais. Copie para .dev.vars (local)
# ou configure via `wrangler secret put`.
# ============================================================

ENVIRONMENT=development
SITE_URL=https://quiz-ake-v2.pages.dev

# Cloudflare D1 já vinculado via wrangler.toml (binding DB)
# AI via Workers AI (binding AI) ou OpenRouter/Gemini:
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1

# Auth
# AUTH_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Pontuação centralizada (ver functions/lib/config.js)
# SCORING_CORRECT=100
# SCORING_SPEED_MAX=20
